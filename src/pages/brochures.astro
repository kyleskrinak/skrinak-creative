---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedGallery from '../components/OptimizedGallery.astro';
import { images } from '../utils/images';

const galleryImages = images.brochures;
---

<BaseLayout
  title="Brochures"
  bannerHeading="Brochures"
  isHome={false}
>
  <div class="page-content">
    <h2 class="page-content__title">Brochures</h2>
    <OptimizedGallery images={galleryImages} category="brochures" />
  </div>
</BaseLayout>
