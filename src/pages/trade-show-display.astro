---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedGallery from '../components/OptimizedGallery.astro';
import { images } from '../utils/images';

const galleryImages = images.tradeShow;
---

<BaseLayout
  title="Trade Show & Display"
  bannerHeading="Trade Show & Display"
  isHome={false}
>
  <div class="page-content">
    <h2 class="page-content__title">Trade Show & Display</h2>
    <OptimizedGallery images={galleryImages} category="trade-show-display" />
  </div>
</BaseLayout>
