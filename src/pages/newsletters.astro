---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedGallery from '../components/OptimizedGallery.astro';
import { images } from '../utils/images';

const galleryImages = images.newsletters;
---

<BaseLayout
  title="Newsletters & One-pagers"
  bannerHeading="Newsletters & One-pagers"
  isHome={false}
>
  <div class="page-content">
    <h2 class="page-content__title">Newsletters & One-pagers</h2>
    <OptimizedGallery images={galleryImages} category="newsletters" />
  </div>
</BaseLayout>
