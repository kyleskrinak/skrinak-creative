---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedGallery from '../components/OptimizedGallery.astro';
import { images } from '../utils/images';

const galleryImages = images.logos;
---

<BaseLayout
  title="Logos & Identity"
  description="Logo and brand identity design services. We create distinctive visual identities that make your company stand out."
  bannerHeading="Logos & Identity"
  isHome={false}
>
  <div class="page-content">
    <h2 class="page-content__title">Logos & Identity</h2>
    <OptimizedGallery images={galleryImages} category="logos-identity" />
  </div>
</BaseLayout>
