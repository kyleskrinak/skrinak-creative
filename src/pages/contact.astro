---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us"
  description="Contact Skrinak Creative in Apex, NC. Reach out to discuss your graphic design and branding needs with our creative team."
  bannerImage="/images/banner-inner.png"
  bannerHeading="Contact Us"
  isHome={false}
>

  <div class="contact-content">

    <p class="contact-intro">
      Interested in working together? Contact us to schedule a consultation.
    </p>

    <hr class="contact-divider" />

    <div class="contact-person">
      <p class="contact-person__name">Elena Skrinak</p>
      <p class="contact-person__info">
        <a href="tel:9196127997">919.612.7997</a> — <a href="mailto:elena@skrinakcreative.com">elena@skrinakcreative.com</a>
      </p>
      <p class="contact-person__role">Owner and Creative Director</p>
    </div>

    <h2 class="contact-map-title">We're located in Apex, NC</h2>

    <iframe
      class="contact-map"
      src="https://www.openstreetmap.org/export/embed.html?bbox=-78.95,35.65,-78.75,35.82&layer=mapnik&marker=35.7339,-78.8498"
      style="border: 0;"
      allowFullScreen=""
      aria-hidden="false"
      tabindex="0">
    </iframe>

  </div>

</BaseLayout>
