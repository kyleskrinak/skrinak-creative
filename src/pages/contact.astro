---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us"
  bannerImage="/images/banner-inner.png"
  bannerHeading="Contact Us"
  isHome={false}
>

  <div class="contact-content">

    <p class="contact-intro">
      Interested in working together? Contact us to schedule a consultation.
    </p>

    <hr class="contact-divider" />

    <div class="contact-person">
      <p class="contact-person__name">Elena Skrinak</p>
      <p class="contact-person__info">
        <a href="tel:9196127997">919.612.7997</a> — <a href="mailto:elena@skrinakcreative.com">elena@skrinakcreative.com</a>
      </p>
      <p class="contact-person__role">Owner and Creative Director</p>
    </div>

    <div class="contact-person">
      <p class="contact-person__name">Kyle Skrinak</p>
      <p class="contact-person__info">
        <a href="tel:9199245015">919.924.5015</a> — <a href="mailto:kyle@skrinakcreative.com">kyle@skrinakcreative.com</a>
      </p>
      <p class="contact-person__role">Owner and IT Director</p>
    </div>

    <div class="contact-address">
      <p class="contact-address__company">Skrinak Creative, Inc.</p>
      <p class="contact-address__street">
        309 Sir Brennan Ct.<br />
        Apex, NC 27523
      </p>
    </div>

    <iframe
      class="contact-map"
      src="https://www.openstreetmap.org/export/embed.html?bbox=-79.5,35.4,-78.1,36.3&layer=mapnik&marker=35.87,-78.78"
      style="border: 0;"
      allowFullScreen=""
      aria-hidden="false"
      tabindex="0">
    </iframe>

  </div>

</BaseLayout>
