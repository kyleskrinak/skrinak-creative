---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedGallery from '../components/OptimizedGallery.astro';
import { images } from '../utils/images';

const galleryImages = images.folders;
---

<BaseLayout
  title="Folders"
  description="Custom folder and document holder design services. Skrinak Creative designs branded folders that organize and impress."
  bannerHeading="Folders"
  isHome={false}
>
  <div class="page-content">
    <h2 class="page-content__title">Folders</h2>
    <OptimizedGallery images={galleryImages} category="folders" />
  </div>
</BaseLayout>
