/**
 * ADD YOUR FOLDER IMAGES HERE.
 * Copy exported images from Squarespace into:
 *   public/images/folders/
 */
const images = [
  { src: '/images/folders/CCfolder.png',          alt: 'CC folder' },
  { src: '/images/folders/e-NC.png',              alt: 'e-NC folder' },
  { src: '/images/folders/GSS.png',               alt: 'GSS folder' },
  { src: "/images/folders/H&M.png",               alt: 'H&M folder' },
