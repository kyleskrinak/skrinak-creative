{
  "name": "skrinak-creative",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:visual": "playwright test",
    "test:visual:desktop": "playwright test --project=desktop",
    "test:visual:tablet": "playwright test --project=tablet",
    "test:visual:mobile": "playwright test --project=mobile",
    "test:visual:baseline": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "test:console": "playwright test tests/console-check.spec.ts",
    "test:console:live": "TEST_URL=https://www.skrinakcreative.com playwright test tests/console-check.spec.ts",
    "test:links": "node scripts/check-links.js",
    "test": "npm run test:visual && npm run test:links"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.2",
    "glightbox": "^3.3.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  },
  "overrides": {
    "devalue": "^5.8.1"
  }
}
